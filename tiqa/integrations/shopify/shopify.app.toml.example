# Shopify app configuration TEMPLATE for Tiqa (copy to shopify.app.toml and deploy with the Shopify CLI).
# ⚠️ Written from shopify.dev docs found via search on 2026-11-22. Verify field names with `shopify app config`
#    before deploying. Replace https://app.example.ma with your public URL (WEB_URL; the API is served under /api).

client_id = "YOUR_SHOPIFY_API_KEY"
name = "Tiqa – Risque de retour COD"
application_url = "https://app.example.ma/dashboard/integrations"
embedded = false

[access_scopes]
scopes = "read_orders,write_orders"

[auth]
redirect_urls = ["https://app.example.ma/api/integrations/shopify/callback"]

[webhooks]
api_version = "2026-10"

  [[webhooks.subscriptions]]
  topics = ["orders/create", "app/uninstalled"]
  uri = "https://app.example.ma/api/integrations/shopify/webhooks"

  # Mandatory privacy compliance webhooks (required for the App Store)
  [[webhooks.subscriptions]]
  compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
  uri = "https://app.example.ma/api/integrations/shopify/webhooks"
