// Tiqa database schema.
// Privacy rules enforced here:
//   - No raw phone numbers anywhere. Shared network = HMAC hash only; merchant history = last 2 digits.
//   - No names, addresses, product details or order amounts.
//   - Money is stored in integer centimes (MAD).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy & auth ───────────────────────────────────────────────────────────

enum MerchantStatus {
  active
  suspended
}

enum Role {
  owner
  admin
  member
}

model Merchant {
  id                      String         @id @default(cuid())
  name                    String
  status                  MerchantStatus @default(active)
  /// Computed by the trust job (Phase 2). 0..1. New merchants start at 1.
  trustWeight             Float          @default(1.0)
  /// Admin override; wins over trustWeight when set.
  trustOverride           Float?
  trustComputedAt         DateTime?
  /// Inputs of the last trust computation (for the admin panel).
  trustDetails            Json?
  /// Cost of one failed COD delivery (shipping both ways, packaging, call), used for the "money saved" estimate.
  failedOrderCostCentimes Int            @default(4000)
  /// Merchant accepted the terms, incl. the duty to inform customers that order data is shared for delivery-risk prevention.
  termsAcceptedAt         DateTime?
  termsVersion            String?
  isSeed                  Boolean        @default(false)
  createdAt               DateTime       @default(now())

  memberships  Membership[]
  apiKeys      ApiKey[]
  outcomes     Outcome[]
  lookups      Lookup[]
  usage        UsageMonthly[]
  subscription Subscription?
  csvImports   CsvImport[]
  invites      Invite[]
  flags        AnomalyFlag[]
  integrations Integration[]
  endpoints    WebhookEndpoint[]
  csvMappings  CsvMapping[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  /// argon2id. Null when the user only signs in with magic links.
  passwordHash    String?
  locale          String    @default("fr")
  emailVerifiedAt DateTime?
  isStaff         Boolean   @default(false)
  createdAt       DateTime  @default(now())

  memberships Membership[]
  sessions    Session[]
  magicLinks  MagicLink[]
}

model Invite {
  id         String    @id @default(cuid())
  merchantId String
  email      String
  role       Role      @default(member)
  tokenHash  Bytes     @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Membership {
  userId     String
  merchantId String
  role       Role     @default(member)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([userId, merchantId])
}

model Session {
  /// sha256 of the session token (the cookie holds the raw token).
  idHash    Bytes    @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MagicLink {
  id        String    @id @default(cuid())
  userId    String
  tokenHash Bytes     @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  merchantId String
  name       String
  /// Public part of the key, used to look it up.
  prefix     String    @unique
  /// sha256 of the secret part.
  secretHash Bytes
  scopes     String[]  @default(["score", "outcomes:write"])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

// ── Shared network: the ONLY cross-merchant data ─────────────────────────────

enum OutcomeType {
  delivered
  refused
  returned
  unreachable
}

enum OutcomeSource {
  carrier_api
  carrier_export
  merchant_manual
}

enum RecordStatus {
  active
  /// Disputed by the consumer; excluded from scoring until reviewed.
  frozen
}

model Outcome {
  id               String        @id @default(cuid())
  phoneHash        Bytes
  hashKeyVersion   Int           @default(1)
  /// Never exposed to other merchants.
  merchantId       String
  outcome          OutcomeType
  source           OutcomeSource @default(merchant_manual)
  carrier          String?
  /// Coarse city code only (see packages/core/src/cities.ts).
  cityCode         String?
  occurredAt       DateTime
  /// The merchant's own order reference, used for de-duplication and to update a status.
  merchantOrderRef String?
  status           RecordStatus  @default(active)
  /// A carrier-sourced record later replaced this merchant-entered record for the same order.
  carrierChecked   Boolean       @default(false)
  /// ...and the carrier said "delivered" where the merchant had reported a refusal / unreachable.
  contradicted     Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  merchant         Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, merchantOrderRef])
  @@index([phoneHash, occurredAt])
  @@index([occurredAt])
  @@index([merchantId, createdAt])
}

// ── Merchant-private ─────────────────────────────────────────────────────────

enum Band {
  low
  medium
  high
  insufficient_data
}

enum LookupDecision {
  shipped
  cancelled
  prepaid_required
}

/// One row per score request. Powers the merchant's "order history with bands".
model Lookup {
  id               String          @id @default(cuid())
  merchantId       String
  phoneHash        Bytes
  /// Only the last 2 digits, for display ("06 •• •• •• 12").
  phoneLast2       String
  merchantOrderRef String?
  band             Band
  score            Int?
  outcomesBucket   String
  merchantsBucket  String
  scoreVersion     String
  channel          String          @default("api")
  /// What the merchant did with the order (merchant-private; feeds the money-saved estimate; never shared).
  decision         LookupDecision?
  createdAt        DateTime        @default(now())
  merchant         Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([merchantId, phoneHash])
}

model CsvImport {
  id          String   @id @default(cuid())
  merchantId  String
  userId      String?
  sourceType  OutcomeSource
  rowsTotal   Int
  inserted    Int
  updated     Int
  skipped     Int
  failed      Int
  /// Per-row errors (row number + error code only; never the phone number).
  errors      Json
  createdAt   DateTime @default(now())
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
}

// ── Compliance ───────────────────────────────────────────────────────────────

enum ActorType {
  api_key
  integration
  user
  staff
  consumer
  system
}

/// Append-only audit trail. Every lookup is recorded (merchant, hashed id, time, result).
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  at         DateTime  @default(now())
  actorType  ActorType
  actorId    String?
  merchantId String?
  action     String
  phoneHash  Bytes?
  result     Json?

  @@index([merchantId, at])
  @@index([phoneHash])
  @@index([at])
}

// ── Billing (payments stubbed until Phase 4) ─────────────────────────────────

model Plan {
  id                       String         @id @default(cuid())
  code                     String         @unique
  nameFr                   String
  nameAr                   String
  monthlyFeeCentimes       Int
  includedLookups          Int
  overageCentimesPerLookup Int
  rateLimitPerMin          Int
  subscriptions            Subscription[]
}

model Subscription {
  merchantId         String   @id
  planId             String
  status             String   @default("active")
  currentPeriodStart DateTime @default(now())
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  plan               Plan     @relation(fields: [planId], references: [id])
}

model UsageMonthly {
  merchantId        String
  /// "YYYY-MM"
  period            String
  lookups           Int      @default(0)
  outcomesSubmitted Int      @default(0)
  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, period])
}

// ── Consumer rights (Law 09-08: access, rectification/dispute, objection/deletion) ─

model OtpChallenge {
  id         String    @id @default(cuid())
  phoneHash  Bytes
  /// sha256(phoneHash || code): the code itself is never stored.
  codeHash   Bytes
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneHash, createdAt])
  @@index([expiresAt])
}

/// Short-lived session after OTP verification, scoped to ONE phone hash.
model ConsumerSession {
  tokenHash Bytes    @id
  phoneHash Bytes
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum RequestType {
  dispute
  deletion
}

enum RequestStatus {
  open
  upheld
  rejected
}

model DataSubjectRequest {
  id             String        @id @default(cuid())
  /// Nulled once a deletion request is carried out (we keep only the fact that it happened).
  phoneHash      Bytes?
  type           RequestType
  status         RequestStatus @default(open)
  /// Optional free text from the consumer (length-limited; we ask for no sensitive data).
  message        String?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?
  createdAt      DateTime      @default(now())
  items          RequestItem[]

  @@index([status, createdAt])
  @@index([phoneHash])
}

/// Snapshot of each record covered by a request (kept so upheld disputes can count against the reporting merchant).
model RequestItem {
  id               String             @id @default(cuid())
  requestId        String
  outcomeId        String?
  merchantId       String
  outcome          OutcomeType
  source           OutcomeSource
  occurredAt       DateTime
  merchantOrderRef String?
  request          DataSubjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([merchantId])
}

// ── Anti-poisoning ───────────────────────────────────────────────────────────

enum FlagStatus {
  open
  dismissed
  actioned
}

model AnomalyFlag {
  id         String     @id @default(cuid())
  merchantId String
  kind       String
  severity   String
  details    Json
  status     FlagStatus @default(open)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime   @default(now())
  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, kind, status])
  @@index([status, createdAt])
}

// ── Integrations (Phase 3) ──────────────────────────────────────────────────

enum IntegrationKind {
  generic
  shopify
  youcan
}

model Integration {
  id               String          @id @default(cuid())
  merchantId       String
  kind             IntegrationKind
  /// Shop domain for Shopify/YouCan; null for the generic webhook.
  externalId       String?
  active           Boolean         @default(true)
  /// AES-256-GCM encrypted platform access token (never stored in clear).
  tokenEnc         String?
  /// sha256 of the secret token in the generic inbound URL.
  inboundTokenHash Bytes?          @unique
  /// e.g. field paths for the generic webhook, scoring options.
  settings         Json            @default("{}")
  lastEventAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  merchant         Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([kind, externalId])
  @@index([merchantId])
}

/// Outbound webhooks: Tiqa → merchant's system (signed with HMAC-SHA256).
model WebhookEndpoint {
  id            String            @id @default(cuid())
  merchantId    String
  url           String
  /// AES-256-GCM encrypted signing secret.
  secretEnc     String
  events        String[]          @default(["score.created"])
  active        Boolean           @default(true)
  failureStreak Int               @default(0)
  createdAt     DateTime          @default(now())
  merchant      Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@index([merchantId])
}

enum DeliveryStatus {
  pending
  delivered
  failed
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  event          String
  /// Never contains a phone number.
  payload        Json
  status         DeliveryStatus  @default(pending)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

/// CSV column mappings remembered per merchant and file layout (header signature),
/// so the second import of the same carrier export is one click.
model CsvMapping {
  id              String        @id @default(cuid())
  merchantId      String
  headerSignature String
  mapping         Json
  sourceType      OutcomeSource
  defaultCarrier  String?
  updatedAt       DateTime      @updatedAt
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, headerSignature])
}
