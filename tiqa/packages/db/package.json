{
  "name": "@tiqa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "seed:load": "tsx --env-file-if-exists=../../.env src/seed-load.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tiqa/core": "workspace:*",
    "@tiqa/scoring": "workspace:*"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "prisma": "6.19.3",
    "dotenv-cli": "^8.0.0"
  }
}
